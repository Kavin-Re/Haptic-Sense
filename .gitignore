# STM32CubeIDE build outputs
Debug/
Release/
*.o
*.d
*.map
*.su
*.cyclo
*.list

# STM32CubeIDE workspace metadata
.metadata/

# Vendored NPU runtime (68 MB binary lib) — kept on disk for the build,
# not tracked in git history
firmware/Lib/AI_Runtime/

# Vendored ST HAL/CMSIS/BSP package (94 MB) — kept on disk for the build,
# not tracked in git history
firmware/STM32Cube_FW_N6/

# Python bytecode (analysis scripts)
__pycache__/

# scratch bundle from the 9-10 Jul session: duplicate PDFs and a STALE
# copy of app_i2c.c. Never track it - duplicate source trees are how the
# firmware/Lib vs Appli/Lib build split happened (plan v2 Block 2.10).
docs/session_bundle/

# vendor datasheets: kept locally and cited by CLAUDE.md, deliberately NOT
# tracked - 10 MB of TI/ST PDFs, and CLAUDE.md SS7 forbids license mixing.
docs/datasheets/

# staging area for files awaiting manual deletion. Contains the SAME July
# bundle that docs/session_bundle/ excludes -- a stale app_i2c.c and ST's
# unfilled vl53l1_platform.c -- under a different name, which defeated that
# rule. 4.7 MB, and re-introducing ST's stub is forbidden (HANDOFF_20260903 SS7).
docs/_to_delete/

# --- Block 6 data-collection / training scratch (added 2026-09-24) ---
# Raw and derived CSVs produced by collect_data*.sh and the aggregation/
# augmentation scripts. Large (several MB each), regenerable from the
# scripts + raw serial logs, not meant to be version-controlled.
training_data_*.csv
held_out_*.csv
held_out_v*_scored.csv
ei_upload_*.csv
boost_angle_labeled.csv

# Scratch/diagnostic logs — serial captures, NPU diagnostic runs, soak-test
# logs dumped at repo root and under logs/. Anchored to root + logs/ only
# (NOT a bare "*.log") so it can never shadow the real evidence .log files
# tracked under docs/evidence/phase4/ and docs/evidence/phase5/.
/*.log
/logs/

# Edge Impulse / TFLite export scratch directories (intermediate model
# export dumps, not the canonical model/ directory)
model_v*_export/
test_export_v*/
tmp_analysis/

# On-target verification scratch dump
network_atonbuf.xSPI2.raw.forverify

# Not redistributable: TRON Forum spec text ("do not transcribe or duplicate without consent")
# and an unofficial English translation of the BSP2 manual; neither is in tron-forum/mtk3_bsp2.
# Kept locally for reference. See docs/PROVENANCE.md.
/firmware/Appli/mtk3_bsp2/doc/utk3_spec.txt
/firmware/Appli/mtk3_bsp2/doc/bsp2_stm32_cube_en.md

# Model v6 (2026-09-18): trained, never converted into firmware artifacts. Kept locally as history.
/haptic_sense_hazard_v6.tflite

# Internal contest-negotiation notes — not part of the technical submission,
# kept locally, deliberately not published
docs/CONTEST_LOGISTICS.md
docs/PACK_SHIP_SUBMIT_CHECKLIST_20260915.md
